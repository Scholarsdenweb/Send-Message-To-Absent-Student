# ===== Server =====
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# ===== Auth =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# First admin created by `npm run seed`
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me

# ===== App database (Postgres via Prisma) =====
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ===== SQL Server (eTimeTrackLite / eSSL) =====
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=etimetracklite1
SQL_USER=your_sql_user
SQL_PASSWORD=your_sql_password
SQL_ENCRYPT=false

# ===== SMS (HSPSMS) =====
HSPSMS_URL=http://sms.hspsms.com/sendSMS
HSPSMS_USER=your_sms_user
HSPSMS_APIKEY=your_sms_apikey
HSPSMS_SENDER=SCHDEN
HSPSMS_SMSTYPE=TRANS
DEFAULT_CC=91
# DLT identifiers from the approved template on the SMS portal
HSPSMS_PEID=your_dlt_entity_id
HSPSMS_TEMPLATEID=your_dlt_template_id
# Contact number shown at the end of the absent SMS
SMS_CONTACT=your_contact_number
# Must match the DLT-approved template EXACTLY. Placeholders: {name} {date} {day} {contact}
SMS_ABSENT_TEMPLATE=Scholars Den Absent Alert: Your ward, {name} is absent in the classes scheduled for today ({date})({day}). For any query please contact, {contact}
